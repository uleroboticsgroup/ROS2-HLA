<?xml version="1.0"?>
<!--
  Mundo DualSim: Dos habitaciones cúbicas conectadas por un pasillo.
  
  Layout (vista superior, coordenadas en metros):
  
       Room A (4x4)        Corridor (2x1.5)       Room B (4x4)
    x=-5          x=-1    x=-1        x=1    x=1           x=5
    ┌──────────────┐                          ┌──────────────┐
    │              │  y=0.75  ┌────────┐ y=0.75│              │  y=2
    │              ├──────────┤        ├───────┤              │
    │   (-3,0)     │          │ (0,0)  │       │   (3,0)      │
    │   Robot ★    ├──────────┤        ├───────┤              │
    │              │ y=-0.75  └────────┘y=-0.75│              │  y=-2
    └──────────────┘                          └──────────────┘
  
  Paredes: 0.15m grosor, 2.5m alto
  Color: gris claro
-->
<sdf version="1.6">
  <world name="default">

    <!-- Plugins del sistema -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Plano de suelo -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <!-- Sol -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- Cámara por defecto: vista cenital -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 0 15 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  ROOM A — Paredes (4m × 4m, centro en -3, 0)   -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- Room A: Pared Oeste (x = -5) -->
    <model name="wall_a_west">
      <static>true</static>
      <pose>-5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 4.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 4.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room A: Pared Sur (y = -2) -->
    <model name="wall_a_south">
      <static>true</static>
      <pose>-3 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room A: Pared Norte (y = 2) -->
    <model name="wall_a_north">
      <static>true</static>
      <pose>-3 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room A: Pared Este-Sur (x = -1, y: -2 a -0.75) -->
    <model name="wall_a_east_south">
      <static>true</static>
      <pose>-1 -1.375 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room A: Pared Este-Norte (x = -1, y: 0.75 a 2) -->
    <model name="wall_a_east_north">
      <static>true</static>
      <pose>-1 1.375 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  PASILLO — Paredes (2m × 1.5m, centro en 0,0)  -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- Pasillo: Pared Sur (y = -0.75) -->
    <model name="wall_corridor_south">
      <static>true</static>
      <pose>0 -0.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pasillo: Pared Norte (y = 0.75) -->
    <model name="wall_corridor_north">
      <static>true</static>
      <pose>0 0.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  ROOM B — Paredes (4m × 4m, centro en 3, 0)    -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- Room B: Pared Este (x = 5) -->
    <model name="wall_b_east">
      <static>true</static>
      <pose>5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 4.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 4.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room B: Pared Sur (y = -2) -->
    <model name="wall_b_south">
      <static>true</static>
      <pose>3 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room B: Pared Norte (y = 2) -->
    <model name="wall_b_north">
      <static>true</static>
      <pose>3 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room B: Pared Oeste-Sur (x = 1, y: -2 a -0.75) -->
    <model name="wall_b_west_south">
      <static>true</static>
      <pose>1 -1.375 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room B: Pared Oeste-Norte (x = 1, y: 0.75 a 2) -->
    <model name="wall_b_west_north">
      <static>true</static>
      <pose>1 1.375 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.25 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
